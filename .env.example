DATABASE_URL=postgresql://postgres.example:replace-me@db.example.supabase.co:5432/postgres?sslmode=require
WORKER_ID=agentic-worker-01
WORKSPACE_ID=00000000-0000-4000-8000-000000000001
AGENT_PROVIDER=fixture
POLL_INTERVAL_MS=5000
LEASE_SECONDS=90
MAX_SOURCE_BYTES=1000000
SOURCE_HOST_ALLOWLIST=docs.github.com,docs.docker.com,supabase.com,www.freedesktop.org,dev.opencode.ai,developer.wordpress.org
REHEARSAL_CRASH_AFTER_LEASE=false

# OpenCode Go is opt-in. Leave these unset while AGENT_PROVIDER=fixture.
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/v1
